# Normalize line endings in the repository to LF; check out with native
# endings only where a tool needs them.
* text=auto eol=lf

*.go     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets
*.png    binary
*.ico    binary
*.icns   binary
*.zip    binary
*.exe    binary
